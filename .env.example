# ─── Firebase / Firestore (optional) ──────────────────────────
# Set these to enable cloud sync via Firestore.
FIREBASE_PROJECT_ID=projects-fff6a
FIREBASE_WEB_API_KEY=your_firebase_web_api_key
FIREBASE_COLLECTION_PREFIX=journ

# ─── Public Firebase config (required for Firebase client SDK) ─
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=projects-fff6a.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=projects-fff6a
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=projects-fff6a.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=414877608107
NEXT_PUBLIC_FIREBASE_APP_ID=1:414877608107:web:866fb598936667b9726fee

# ─── Data path ────────────────────────────────────────────────
# Where the roadmap JSON files live.
# Defaults to <project_root>/data/ (the repo template).
# Set to ~/.journey/data/ to use a system-wide personal data store
# (the path read by the MCP server).
# JOURNEY_DATA_PATH=~/.journey/data
